import { echo } from "io"
alias OnClick = fn() void

struct ButtonProps {
  label: string;
  onClick: OnClick;
}

fn Button(props: ButtonProps) ReactNode {
  return <button onClick={props.onClick}>{props.label}</button>
}

fn handleClick() void {
  echo("clicked")
}

export fn Page() ReactNode {
  return <Button label={"Click me"} onClick={handleClick} />
}
