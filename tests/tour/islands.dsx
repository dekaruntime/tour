import { echo } from "io"

struct CounterProps {
  start: number;
}

fn Counter(props: CounterProps) ReactNode {
  return <button>{props.start}</button>
}

struct Rendered { html: string }

const element = <Counter client={"load"} start={5} />
const result = unsafe<Rendered> { deka.ui.renderToString(element) }
match (result) {
  Ok(r) => echo(r.html),
  Err(e) => echo(e.message),
}

export fn Page() ReactNode {
  return <Counter client={"load"} start={5} />
}
